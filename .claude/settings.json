{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(bash ./publish.sh:*)",
      "Bash(PYTHONUTF8=1 python -m unittest:*)",
      "Bash(python -m unittest:*)",
      "Bash(python -m compileall -q games/sts2/tools scripts/publish)"
    ],
    "deny": [
      "Read(**/art-backend.json)"
    ]
  }
}
