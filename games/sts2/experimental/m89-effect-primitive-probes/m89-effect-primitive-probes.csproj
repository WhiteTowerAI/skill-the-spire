<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultItems>true</EnableDefaultItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(Sts2DataDir)') and Exists('$(RitsuLibCompileAssemblyPath)')">
    <Reference Include="sts2" HintPath="$(Sts2DataDir)\sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)\GodotSharp.dll" Private="false" />
    <Reference Include="System.IO.Hashing" HintPath="$(Sts2DataDir)\System.IO.Hashing.dll" Private="false" />
    <Reference Include="STS2-RitsuLib" HintPath="$(RitsuLibCompileAssemblyPath)" Private="false" />
  </ItemGroup>
  <Target Name="CheckProbeInputs" BeforeTargets="Build">
    <Error Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)\sts2.dll')"
           Text="Set Sts2DataDir to the pinned STS2 data directory." />
    <Error Condition="'$(RitsuLibCompileAssemblyPath)' == '' or !Exists('$(RitsuLibCompileAssemblyPath)')"
           Text="Set RitsuLibCompileAssemblyPath to the pinned Compat DLL." />
  </Target>
</Project>
