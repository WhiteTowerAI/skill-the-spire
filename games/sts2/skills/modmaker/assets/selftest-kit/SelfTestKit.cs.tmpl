        await WaitUntil(() => (button = EventButtons().FirstOrDefault(b => Matches(b.Option))) is { IsEnabled: true },
            $"Event option {key} is not shown and enabled; shown: " +
            string.Join(",", EventButtons().Select(b => b.Option.TextKey + (b.IsEnabled ? "" : "(disabled)"))));
        var option = button!.Option;
        await UiHelper.Click(button);
        await WaitUntil(() => option.WasChosen || !GodotObject.IsInstanceValid(button) || !button.Visible,
            $"Event option {key} did not respond");
        await Settle();
    }

