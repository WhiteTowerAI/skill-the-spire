using System.Security.Cryptography;
using System.Reflection;
using System.Text.Json;
using System.Text.RegularExpressions;
using MegaCrit.Sts2.Core.Entities.Cards;
using MegaCrit.Sts2.Core.Localization;
using MegaCrit.Sts2.Core.Localization.DynamicVars;
using MegaCrit.Sts2.Core.Models;
using STS2RitsuLib;
using STS2RitsuLib.Models;

namespace __MOD_NAME__;

public static partial class MainFile
{
    static partial void RegisterContent()
    {
        RitsuLibFramework.SubscribeLifecycle<ModelPreloadingCompletedEvent>(
            (_, subscription) =>
            {
                subscription.Dispose();
                RuntimeCatalogCollector.Write();
            });
    }
}

internal static class RuntimeCatalogCollector
{
    private const string Schema = "openmod.sts2.vanilla-runtime-catalog/v2";

    public static void Write()
    {
        try
        {
            var gameAssembly = typeof(ModelDb).Assembly;
            var sources = CollectSources(gameAssembly);
            var modelEntries = ModelDb.AllAbstractModelSubtypes
                .Where(type => type.Assembly == gameAssembly && !type.IsAbstract)
                .Select(type => new RuntimeModelEntry(type, ModelDb.GetById<AbstractModel>(ModelDb.GetId(type))))
                .ToArray();
            var titleLocalizations = CollectTitleLocalizations(modelEntries.Select(entry => entry.Model));
            var models = modelEntries
                .Select(entry => CollectModel(entry, sources, titleLocalizations))
                .OrderBy(model => model.Id, StringComparer.Ordinal)
                .ToArray();
            var snapshot = new RuntimeSnapshot(
                Schema,
                "__HOST_VERSION__",
                "__PROFILE_ID__",
                Sha256File(gameAssembly.Location),
                LocManager.Languages.OrderBy(language => language, StringComparer.Ordinal).ToArray(),
                models);
            var output = Path.Combine(
                Path.GetDirectoryName(typeof(MainFile).Assembly.Location)!,
                "openmod-m67-runtime-catalog.json");
            File.WriteAllText(output, JsonSerializer.Serialize(snapshot, JsonOptions()) + Environment.NewLine);
            var snapshotSha256 = Sha256File(output);
            MainFile.Logger.Info(
                $"[OPENMOD-M67-CATALOG] done models={models.Length} sha256={snapshot.AssemblySha256} path={output}");
            MainFile.Logger.Info(
                $"[T2MOD-SELFTEST] {MainFile.ModId} state proof: catalog_models={models.Length} " +
                $"snapshot_sha256={snapshotSha256} assembly_sha256={snapshot.AssemblySha256}");
            MainFile.Logger.Info(
                $"[T2MOD-SELFTEST] {MainFile.ModId} selftest done catalog_models={models.Length}");
        }
        catch (Exception exception)
        {
            MainFile.Logger.ErrorNoTrace($"[OPENMOD-M67-CATALOG] FAILED: {exception}");
            MainFile.Logger.ErrorNoTrace(
                $"[T2MOD-SELFTEST] {MainFile.ModId} selftest FAILED catalog={exception.GetType().Name}");
        }
    }

    private static RuntimeModel CollectModel(
        RuntimeModelEntry entry,
        IReadOnlyDictionary<string, SortedDictionary<string, string[]>> sources,
        IReadOnlyDictionary<string, TitleLocalizationRecord> titleLocalizations)
    {
        var type = entry.Type;
        var model = entry.Model;
        var id = model.Id;
        return new RuntimeModel(
            id.ToString(),
            type.FullName ?? type.Name,
            ContentKind(model),
            IsDebug(type, id),
            titleLocalizations.GetValueOrDefault(id.ToString()),
            CollectProperties(model),
            sources.GetValueOrDefault(id.ToString()) ?? new(StringComparer.Ordinal));
    }

    private static IReadOnlyDictionary<string, TitleLocalizationRecord> CollectTitleLocalizations(
        IEnumerable<AbstractModel> models)
    {
        var targets = models
            .Select(model =>
            {
                if (!model.TryGetTitleLocStringSource(out var source)) return null;
                return new TitleLocalizationTarget(
                    model.Id.ToString(),
                    source.Table,
                    source.Key(model),
                    new(StringComparer.Ordinal));
            })
            .OfType<TitleLocalizationTarget>()
            .OrderBy(target => target.ModelId, StringComparer.Ordinal)
            .ToArray();

        var locManager = LocManager.Instance;
        var originalLanguage = locManager.Language;
        try
        {
            foreach (var language in LocManager.Languages.OrderBy(value => value, StringComparer.Ordinal))
            {
                locManager.SetLanguage(language);
                if (locManager.OverridesActive)
                    throw new InvalidOperationException(
                        $"Localization overrides are active for {language}; refusing a machine-local catalog");

                foreach (var target in targets)
                {
                    var table = locManager.GetTable(target.Table);
                    if (!table.IsLocalKey(target.Key)) continue;
                    var title = table.GetRawText(target.Key).Trim();
                    if (title.Length > 0)
                        target.LocalizedTitles[language] = title;
                }
            }
        }
        finally
        {
            if (!string.Equals(locManager.Language, originalLanguage, StringComparison.Ordinal))
                locManager.SetLanguage(originalLanguage);
        }

        return targets.ToDictionary(
            target => target.ModelId,
            target => new TitleLocalizationRecord(target.Table, target.Key, target.LocalizedTitles),
            StringComparer.Ordinal);
    }

    private static SortedDictionary<string, object?> CollectProperties(AbstractModel model)
    {
        var properties = new SortedDictionary<string, object?>(StringComparer.Ordinal);
        switch (model)
        {
            case CardModel card:
                properties["card_type"] = card.Type.ToString();
                properties["rarity"] = card.Rarity.ToString();
                properties["target_type"] = card.TargetType.ToString();
                properties["energy_cost"] = card.EnergyCost.Canonical;
                properties["energy_cost_x"] = card.EnergyCost.CostsX;
                properties["star_cost"] = card.CanonicalStarCost;
                properties["star_cost_x"] = card.HasStarCostX;
                properties["max_upgrade_level"] = card.MaxUpgradeLevel;
                properties["tags"] = card.Tags.Select(value => value.ToString())
                    .OrderBy(value => value, StringComparer.Ordinal).ToArray();
                properties["keywords"] = card.CanonicalKeywords.Select(value => value.ToString())
                    .OrderBy(value => value, StringComparer.Ordinal).ToArray();
                properties["dynamic_vars"] = CollectDynamicVars(card.DynamicVars);
                properties["upgrade_levels"] = CollectCardUpgrades(card);
                break;
            case RelicModel relic:
                properties["rarity"] = relic.Rarity.ToString();
                properties["dynamic_vars"] = CollectDynamicVars(relic.DynamicVars);
                break;
            case PotionModel potion:
                properties["rarity"] = potion.Rarity.ToString();
                properties["usage"] = potion.Usage.ToString();
                properties["target_type"] = potion.TargetType.ToString();
                break;
            case PowerModel power:
                properties["power_type"] = power.Type.ToString();
                properties["stack_type"] = power.StackType.ToString();
                properties["allow_negative"] = power.AllowNegative;
                properties["scales_in_multiplayer"] = power.ShouldScaleInMultiplayer;
                properties["dynamic_vars"] = CollectDynamicVars(power.DynamicVars);
                break;
            case EnchantmentModel enchantment:
                properties["stackable"] = enchantment.IsStackable;
                properties["dynamic_vars"] = CollectDynamicVars(enchantment.DynamicVars);
                break;
            case AfflictionModel affliction:
                properties["stackable"] = affliction.IsStackable;
                properties["can_afflict_unplayable"] = affliction.CanAfflictUnplayableCards;
                break;
            case MonsterModel monster:
                properties["min_initial_hp"] = monster.MinInitialHp;
                properties["max_initial_hp"] = monster.MaxInitialHp;
                properties["show_in_compendium"] = monster.ShouldShowInCompendium;
                break;
            case ActModel act:
                properties["index"] = act.Index;
                properties["is_default"] = act.IsDefault;
                break;
            case EncounterModel encounter:
                properties["room_type"] = encounter.RoomType.ToString();
                properties["is_weak"] = encounter.IsWeak;
                break;
            case CardPoolModel cardPool:
                properties["is_colorless"] = cardPool.IsColorless;
                break;
        }
        return properties;
    }

    private static UpgradeRecord[] CollectCardUpgrades(CardModel canonical)
    {
        if (canonical.MaxUpgradeLevel <= 0)
            return [];
        var card = canonical.ToMutable();
        var levels = new List<UpgradeRecord>();
        for (var level = 1; level <= canonical.MaxUpgradeLevel; level++)
        {
            card.UpgradeInternal();
            levels.Add(new UpgradeRecord(
                level,
                card.EnergyCost.GetWithModifiers(CostModifiers.Local),
                card.CurrentStarCost,
                CollectDynamicVars(card.DynamicVars)));
            card.FinalizeUpgradeInternal();
        }
        return [.. levels];
    }

    private static DynamicVarRecord[] CollectDynamicVars(DynamicVarSet variables)
    {
        return variables.Values
            .OrderBy(variable => variable.Name, StringComparer.Ordinal)
            .Select(variable => new DynamicVarRecord(
                variable.Name,
                variable.GetType().FullName ?? variable.GetType().Name,
                variable.BaseValue))
            .ToArray();
    }

    private static Dictionary<string, SortedDictionary<string, string[]>> CollectSources(Assembly gameAssembly)
    {
        var raw = new Dictionary<string, Dictionary<string, SortedSet<string>>>(StringComparer.Ordinal);
        foreach (var pool in ModelDb.AllCardPools.Where(pool => pool.GetType().Assembly == gameAssembly))
            foreach (var id in pool.AllCardIds)
                AddSource(raw, id, "card_pools", pool.Id.ToString());
        foreach (var pool in ModelDb.AllRelicPools.Where(pool => pool.GetType().Assembly == gameAssembly))
            foreach (var id in pool.AllRelicIds)
                AddSource(raw, id, "relic_pools", pool.Id.ToString());
        foreach (var pool in ModelDb.AllPotionPools.Where(pool => pool.GetType().Assembly == gameAssembly))
            foreach (var id in pool.AllPotionIds)
                AddSource(raw, id, "potion_pools", pool.Id.ToString());
        foreach (var act in ModelDb.Acts.Where(act => act.GetType().Assembly == gameAssembly))
        {
            foreach (var model in act.AllAncients)
                AddSource(raw, model.Id, "acts", act.Id.ToString());
            foreach (var model in act.AllEvents)
                AddSource(raw, model.Id, "acts", act.Id.ToString());
            foreach (var model in act.AllEncounters)
                AddSource(raw, model.Id, "acts", act.Id.ToString());
            foreach (var model in act.AllMonsters)
                AddSource(raw, model.Id, "acts", act.Id.ToString());
        }
        foreach (var model in ModelDb.AllSharedEvents)
            AddSource(raw, model.Id, "shared_sources", "events");
        foreach (var model in ModelDb.AllSharedAncients)
            AddSource(raw, model.Id, "shared_sources", "ancients");

        return raw.ToDictionary(
            pair => pair.Key,
            pair => new SortedDictionary<string, string[]>(
                pair.Value.ToDictionary(
                    source => source.Key,
                    source => source.Value.ToArray(),
                    StringComparer.Ordinal),
                StringComparer.Ordinal),
            StringComparer.Ordinal);
    }

    private static void AddSource(
        IDictionary<string, Dictionary<string, SortedSet<string>>> sources,
        ModelId modelId,
        string sourceKind,
        string sourceId)
    {
        if (!sources.TryGetValue(modelId.ToString(), out var modelSources))
        {
            modelSources = new(StringComparer.Ordinal);
            sources[modelId.ToString()] = modelSources;
        }
        if (!modelSources.TryGetValue(sourceKind, out var values))
        {
            values = new(StringComparer.Ordinal);
            modelSources[sourceKind] = values;
        }
        values.Add(sourceId);
    }

    private static string ContentKind(AbstractModel model) => model switch
    {
        AncientEventModel => "ancient",
        EventModel => "event",
        CardModel => "card",
        RelicModel => "relic",
        PotionModel => "potion",
        PowerModel => "power",
        OrbModel => "orb",
        EnchantmentModel => "enchantment",
        AfflictionModel => "affliction",
        MonsterModel => "monster",
        EncounterModel => "encounter",
        ActModel => "act",
        CharacterModel => "character",
        CardPoolModel => "card_pool",
        RelicPoolModel => "relic_pool",
        PotionPoolModel => "potion_pool",
        ModifierModel => "modifier",
        _ => Regex.Replace(model.GetType().BaseType?.Name ?? "model", "Model$", "").ToLowerInvariant()
    };

    private static bool IsDebug(Type type, ModelId id)
    {
        var ns = type.Namespace ?? "";
        return ns.Contains(".Mocks", StringComparison.Ordinal) ||
               type.Name.StartsWith("Mock", StringComparison.Ordinal) ||
               id.Entry.StartsWith("MOCK_", StringComparison.Ordinal);
    }

    private static string Sha256File(string path)
    {
        using var source = File.OpenRead(path);
        return Convert.ToHexString(SHA256.HashData(source)).ToLowerInvariant();
    }

    private static JsonSerializerOptions JsonOptions() => new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.SnakeCaseLower,
        WriteIndented = true
    };

    private sealed record DynamicVarRecord(string Name, string Type, decimal BaseValue);
    private sealed record RuntimeModelEntry(Type Type, AbstractModel Model);
    private sealed record TitleLocalizationTarget(
        string ModelId,
        string Table,
        string Key,
        SortedDictionary<string, string> LocalizedTitles);
    private sealed record TitleLocalizationRecord(
        string Table,
        string Key,
        SortedDictionary<string, string> LocalizedTitles);
    private sealed record UpgradeRecord(
        int Level,
        int EnergyCost,
        int StarCost,
        DynamicVarRecord[] DynamicVars);
    private sealed record RuntimeModel(
        string Id,
        string Type,
        string ContentKind,
        bool IsDebug,
        TitleLocalizationRecord? TitleLocalization,
        SortedDictionary<string, object?> Properties,
        SortedDictionary<string, string[]> Sources);
    private sealed record RuntimeSnapshot(
        string Schema,
        string HostVersion,
        string Profile,
        string AssemblySha256,
        string[] LocalizationLanguages,
        RuntimeModel[] Models);
}
