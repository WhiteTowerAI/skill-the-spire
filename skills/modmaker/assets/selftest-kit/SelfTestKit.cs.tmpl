    {
        Add(new SelfTestScenario(name, SelfTestHost.RunStart, body, TimeSpan.FromSeconds(budgetSeconds)));
        return this;
    }

    /// <summary>
    /// A player-combat scenario. It shares one combat with the previous scenario after a reset,
    /// unless <paramref name="freshCombat"/> is set or <paramref name="beforeCombat"/> is given:
    /// then the kit finishes the current combat, runs <paramref name="beforeCombat"/>, and starts
    /// a new one, so turn-1 and combat-start triggers fire.
    /// </summary>
    public SelfTestPlan Combat(string name, Func<SelfTestRun, Task> body, int budgetSeconds = 30,
        bool freshCombat = false, Func<SelfTestRun, Task>? beforeCombat = null)
    {
        Add(new SelfTestScenario(name, SelfTestHost.Combat, body, TimeSpan.FromSeconds(budgetSeconds),
            freshCombat || beforeCombat != null, beforeCombat));
        return this;
    }

    /// <summary>
    /// A two-player combat scenario, run only by <c>launch.py --multiplayer</c> (singleplayer
    /// reports it SKIP). Both peers run the body for their own player: <c>t.Player</c> is the local
