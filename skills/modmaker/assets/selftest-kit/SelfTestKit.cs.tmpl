/// <summary>Scripted answer for Card choices while it is not disposed.</summary>
internal sealed class SelfTestChoices : IDisposable
{
    private readonly IDisposable _scope;
    public readonly List<int> OfferedCounts = new();
    public readonly List<CardModel> Picked = new();

    internal SelfTestChoices(Func<IReadOnlyList<CardModel>, IEnumerable<CardModel>> pick)
    {
        _scope = CardSelectCmd.UseSelector(new Selector(this, pick));
    }

    public void Dispose() => _scope.Dispose();

    private sealed class Selector : MegaCrit.Sts2.Core.TestSupport.ICardSelector
    {
        private readonly SelfTestChoices _owner;
        private readonly Func<IReadOnlyList<CardModel>, IEnumerable<CardModel>> _pick;

        public Selector(SelfTestChoices owner, Func<IReadOnlyList<CardModel>, IEnumerable<CardModel>> pick)
        {
            _owner = owner;
            _pick = pick;
        }

        public Task<IEnumerable<CardModel>> GetSelectedCards(IEnumerable<CardModel> options, int minSelect, int maxSelect)
        {
            var offered = options.ToList();
            _owner.OfferedCounts.Add(offered.Count);
            var picked = _pick(offered).Take(maxSelect).ToList();
            _owner.Picked.AddRange(picked);
            return Task.FromResult<IEnumerable<CardModel>>(picked);
        }

        public MegaCrit.Sts2.Core.TestSupport.CardRewardSelection GetSelectedCardReward(
            IReadOnlyList<CardCreationResult> options, IReadOnlyList<CardRewardAlternative> alternatives)
            => new() { card = options.FirstOrDefault()?.Card };
    }
}

/// <summary>The handle every scenario receives. Combat members need a combat in progress.</summary>
internal sealed class SelfTestRun
{
    // By owner and type, not by object: in multiplayer every room entry rebuilds the remote
    // players' Relics, Potions, and Deck from synchronized state, so references go stale.
    internal readonly List<(Player Owner, Type Type)> OwnedRelics = new();
    internal readonly List<(Player Owner, Type Type)> OwnedPotions = new();
    internal readonly List<CardModel> CreatedCards = new();

    internal SelfTestRun(Player player, CancellationToken token, string name, bool coop = false)
    {
        Player = player;
        Token = token;
        Name = name;
        Coop = coop;
    }

    public string Name { get; }
    /// <summary>
    /// The acting player: the only player in singleplayer, the host's player in a multiplayer run
    /// (on both peers), or the local player in a <see cref="SelfTestPlan.Coop"/> scenario.
    /// </summary>
    public Player Player { get; }
    public CancellationToken Token { get; }
    /// <summary>True in a <see cref="SelfTestPlan.Coop"/> scenario: both peers act for themselves.</summary>
    public bool Coop { get; }
    /// <summary>True when this run has more than one player.</summary>
    public bool Multiplayer => SelfTestNet.Multiplayer;
    /// <summary>The other player of a two-player run.</summary>
    public Player Ally => Run.Players.FirstOrDefault(p => p != Player)
        ?? throw new InvalidOperationException("this run has no second player");
    /// <summary>True on the peer whose input drives this scenario's interactions.</summary>
    internal bool Acts => Coop || !SelfTestNet.Multiplayer || SelfTestNet.IsHost;

    /// <summary>
    /// Change game state on every peer, in queue order. The body receives the acting player
    /// (in a Coop scenario, each peer's own player) and must reach every model through it or
    /// through shared state, never through a Coop peer's local objects. Singleplayer runs it at once.
    /// </summary>
    public Task Do(Func<Player, Task> body, string label = "do")
        => SelfTestNet.Step<object?>(label, Player, async p => { await body(p); return null; }, Coop, Token);

    /// <summary>As <see cref="Do(Func{Player, Task}, string)"/>, returning this peer's copy of the result.</summary>
    public Task<T> Do<T>(Func<Player, Task<T>> body, string label = "do")
        => SelfTestNet.Step(label, Player, body, Coop, Token);

    /// <summary>
    /// Wait until every interaction the acting peer(s) queued so far has resolved on this peer
    /// too. Singleplayer settles the queue.
    /// </summary>
    public async Task Sync(string label = "sync")
    {
        await Settle();
        await SelfTestNet.Step<object?>(label, Player, _ => Task.FromResult<object?>(null), Coop, Token);
        await Settle();
    }
    public SelfTestTrail Trail { get; } = new();
    public Creature Me => Player.Creature;
    public PlayerCombatState Combat => Player.PlayerCombatState
        ?? throw new InvalidOperationException("no player combat state");
    public ICombatState State => CombatManager.Instance.DebugOnlyGetState()
        ?? throw new InvalidOperationException("no combat state");
    public IReadOnlyList<Creature> Enemies => State.HittableEnemies;
    public Creature Enemy => State.HittableEnemies.FirstOrDefault()
        ?? throw new InvalidOperationException("no hittable enemy");

    /// <summary>Assert one SPEC fact. A false condition stops this scenario as a failure.</summary>
    public void Proof(bool condition, string observation)
    {
        if (!condition)
            throw new SelfTestProofFailed(observation);
        SelfTestKit.Log($"state proof: {Name}: {observation}");
    }

    public int PowerAmount<TPower>(Creature creature) where TPower : PowerModel
        => creature.GetPower<TPower>()?.Amount ?? 0;

    /// <summary>Wait until the action queue is empty and idle for two frames.</summary>
    public async Task Settle()
    {
        var runs = RunManager.Instance;
        var deadline = DateTime.UtcNow + TimeSpan.FromSeconds(20);
        int quiet = 0;
        while (quiet < 2)
        {
            Token.ThrowIfCancellationRequested();
            await SelfTestKit.NextFrame();
            // A multiplayer step from a faster peer waits in the queue for this peer's scenario
            // code to reach it; everything queued before it has run, so that counts as settled.
            quiet = (runs.ActionQueueSet.IsEmpty && !runs.ActionExecutor.IsRunning) ||
                    SelfTestNet.AwaitingRegistration ? quiet + 1 : 0;
            if (DateTime.UtcNow > deadline)
                throw new TimeoutException("the action queue did not settle in 20s; " +
                    "an unscripted choice screen may be waiting (use ScriptChoices)");
        }
    }

    /// <summary>Create a live copy of the Card in the Hand, upgraded when asked.</summary>
    public Task<CardModel> AddToHand<TCard>(bool upgraded = false) where TCard : CardModel
        => Do(async owner =>
        {
            var card = State.CreateCard(ModelDb.AllCards.OfType<TCard>().First(), owner);
            if (upgraded)
                CardCmd.Upgrade(card);
            await CardPileCmd.Add(card, PileType.Hand);
            CreatedCards.Add(card);
            return card;
        }, $"add {typeof(TCard).Name}");

    /// <summary>
    /// Play a Hand Card the way a player's click does (validation, Energy and Star payment,
    /// normal play lifecycle), then wait for the queue. Tops Energy up to the cost when short.
    /// An AnyEnemy Card without a target uses the first hittable enemy.
    /// </summary>
    public async Task Play(CardModel card, Creature? target = null)
    {
        SelfTestKit.Step($"{Name}: playing {card.Id.Entry}");
        int cost = card.EnergyCost.GetResolved();
        var cardType = card.GetType();
        // Every peer registers this step, so it is unconditional; a Coop peer runs it for each
        // player's own copy, found through that player.
        await Do(async owner =>
        {
            var own = !Coop ? card
                : CreatedCards.LastOrDefault(c => c.Owner == owner && c.GetType() == cardType)
                  ?? owner.PlayerCombatState!.Hand.Cards.First(c => c.GetType() == cardType);
            if (own.Pile?.Type != PileType.Hand)
                await CardPileCmd.Add(own, PileType.Hand);
            if (owner.PlayerCombatState!.Energy < cost)
                await PlayerCmd.SetEnergy(cost, owner);
        }, $"ready {card.Id.Entry}");
        if (card.TargetType == TargetType.AnyEnemy && target == null)
            target = Enemy;
        if (Acts)
        {
            if (!card.CanPlay(out var reason, out var preventer))
                throw new SelfTestProofFailed($"{card.Id.Entry} cannot be played: {reason}" +
                    (preventer != null ? $" (blocked by {preventer.Id.Entry})" : ""));
            if (!card.TryManualPlay(target))
                throw new SelfTestProofFailed($"{card.Id.Entry} rejected target " +
                    $"{target?.Monster?.Id.Entry ?? target?.Player?.NetId.ToString() ?? "none"}");
        }
        await Sync($"played {card.Id.Entry}");
    }

    public async Task<CardModel> Play<TCard>(Creature? target = null, bool upgraded = false) where TCard : CardModel
    {
        var card = await AddToHand<TCard>(upgraded);
        await Play(card, target);
        return card;
    }

    /// <summary>Obtain the Relic for this scenario; the kit removes it afterwards.</summary>
    public Task<TRelic> ObtainRelic<TRelic>() where TRelic : RelicModel
        => Do(async owner =>
        {
            var relic = (TRelic)await RelicCmd.Obtain(ModelDb.AllRelics.OfType<TRelic>().First().ToMutable(), owner);
            OwnedRelics.Add((owner, typeof(TRelic)));
            return relic;
        }, $"obtain {typeof(TRelic).Name}");

    /// <summary>
    /// The acting player's live <typeparamref name="TRelic"/>. Read it again after entering a room:
    /// in multiplayer a room entry rebuilds remote players' Relics, so an older reference is stale.
    /// </summary>
    public TRelic Relic<TRelic>() where TRelic : RelicModel
        => Player.Relics.OfType<TRelic>().LastOrDefault()
           ?? throw new SelfTestProofFailed($"{typeof(TRelic).Name} is not owned; relics: {string.Join(",", RelicNames())}");

    /// <summary>Procure the Potion, use it on the target (default: first enemy, or yourself), and wait.</summary>
    public async Task<TPotion> UsePotion<TPotion>(Creature? target = null) where TPotion : PotionModel
    {
        SelfTestKit.Step($"{Name}: using {typeof(TPotion).Name}");
        var potion = await Do(async owner =>
        {
            var procured = (TPotion)ModelDb.AllPotions.OfType<TPotion>().First().ToMutable();
            var result = await PotionCmd.TryToProcure(procured, owner);
            if (!result.success)
                throw new InvalidOperationException($"could not procure {procured.Id.Entry}: {result.failureReason}");
            OwnedPotions.Add((owner, typeof(TPotion)));
            return procured;
        }, $"procure {typeof(TPotion).Name}");
        target ??= potion.TargetType == TargetType.AnyEnemy ? Enemy : Me;
        if (Acts)
            potion.EnqueueManualUse(target);
        await Sync($"used {potion.Id.Entry}");
        return potion;
    }

    /// <summary>Answer every Card choice with <paramref name="pick"/> until disposed.</summary>
    public SelfTestChoices ScriptChoices(Func<IReadOnlyList<CardModel>, IEnumerable<CardModel>> pick)
        => new(pick);

    /// <summary>
    /// End the turn and wait for the next player Play phase. Enemies are stunned for that turn
    /// unless <paramref name="enemiesAct"/> is set, so their moves cannot touch the state you measure.
    /// </summary>
    public async Task EndTurn(bool enemiesAct = false)
    {
        await Settle();
        int turn = Combat.TurnNumber;
        SelfTestKit.Step($"{Name}: ending turn {turn}");
        if (!enemiesAct)
        {
            // Shared setup: in a Coop scenario only the host stuns, once.
            await SelfTestNet.Step<object?>("stun enemies", Player, async _ =>
            {
                foreach (var enemy in State.Enemies.Where(e => e.IsAlive && e.Monster != null).ToList())
                    await CreatureCmd.Stun(enemy, enemy.Monster!.NextMove.Id);
                return null;
            }, false, Token);
        }
        // Every player must end the turn; each peer ends its own, through the queue in multiplayer.
        var me = SelfTestNet.Multiplayer ? SelfTestNet.LocalPlayer() : Player;
        if (SelfTestNet.Multiplayer)
            RunManager.Instance.ActionQueueSynchronizer.RequestEnqueue(new EndPlayerTurnAction(me, me.PlayerCombatState!.TurnNumber));
        else
            PlayerCmd.EndTurn(Player, canBackOut: false);
        await WaitHelper.Until(
            () => !CombatManager.Instance.IsInProgress ||
                  (me.PlayerCombatState?.TurnNumber == turn + 1 && me.PlayerCombatState.Phase == PlayerTurnPhase.Play),
            Token, TimeSpan.FromSeconds(45), $"player turn {turn + 1} not reached");
        await Settle();
    }

    /// <summary>Finish this combat and start a new one; turn 1 and combat-start triggers fire again.</summary>
    public Task StartNewCombat() => SelfTestKit.EnterFreshCombat(this, null);

    public Task ClearDebuffs(Creature creature)
        => Do(async _ =>
        {
            foreach (var power in creature.Powers.Where(p => p.Type == PowerType.Debuff).ToList())
                await PowerCmd.Remove(power);
        }, "clear debuffs");

    /// <summary>The live enemy Creature whose Monster is <typeparamref name="TMonster"/>.</summary>
    public Creature Monster<TMonster>() where TMonster : MonsterModel
        => State.Enemies.FirstOrDefault(enemy => enemy.Monster is TMonster)
           ?? throw new SelfTestProofFailed($"{typeof(TMonster).Name} is not in this combat; enemies: " +
               string.Join(",", State.Enemies.Select(enemy => enemy.Monster?.Id.Entry ?? "?")));

    /// <summary>The move this monster will perform on its next turn, with its intents.</summary>
    public MoveState NextMove(Creature monster)
        => (monster.Monster ?? throw new InvalidOperationException("creature has no monster model")).NextMove;

    /// <summary>
    /// Drive one real enemy turn: assert the monster's next move is <paramref name="expectedMoveId"/>,
    /// end the player turn with enemies acting, assert from combat history that the monster
    /// performed exactly that move, and return the player HP it cost and the hits it landed.
    /// </summary>
    public async Task<SelfTestEnemyTurn> EnemyTurn(Creature monster, string expectedMoveId)
    {
        var model = monster.Monster ?? throw new InvalidOperationException("creature has no monster model");
        Proof(model.NextMove.Id == expectedMoveId,
            $"{model.Id.Entry} next move expected={expectedMoveId} observed={model.NextMove.Id}");
        var history = CombatManager.Instance.History;
        int movesBefore = history.Entries.OfType<MonsterPerformedMoveEntry>().Count(e => ReferenceEquals(e.Monster, model));
        int attacksBefore = history.Entries.OfType<CreatureAttackedEntry>().Count(e => ReferenceEquals(e.Actor, monster));
        // Vanilla monster attacks hit every player in multiplayer; count only what reached the
        // acting player, so a scenario reads the same in both modes.
        int hp = Me.CurrentHp;
        await EndTurn(enemiesAct: true);
        var performed = history.Entries.OfType<MonsterPerformedMoveEntry>()
            .Where(e => ReferenceEquals(e.Monster, model)).Skip(movesBefore).Select(e => e.Move.Id).ToList();
        Proof(performed.Count == 1 && performed[0] == expectedMoveId,
            $"{model.Id.Entry} performed expected={expectedMoveId} observed={string.Join(",", performed)}");
        var attacks = history.Entries.OfType<CreatureAttackedEntry>()
            .Where(e => ReferenceEquals(e.Actor, monster)).Skip(attacksBefore).ToList();
        var onMe = attacks.SelectMany(e => e.DamageResults).Where(result => result.Receiver == Me).ToList();
        return new SelfTestEnemyTurn(expectedMoveId, hp - Me.CurrentHp, onMe.Count,
            onMe.Sum(result => result.UnblockedDamage));
    }

    /// <summary>Wait until <paramref name="condition"/> holds, within this scenario's budget.</summary>
    public Task WaitUntil(Func<bool> condition, string what, int seconds = 15)
        => WaitUntil(condition, () => what, seconds);

    /// <summary>As <see cref="WaitUntil(Func{bool}, string, int)"/>, describing the state only when it times out.</summary>
    public async Task WaitUntil(Func<bool> condition, Func<string> what, int seconds = 15)
    {
        var deadline = DateTime.UtcNow + TimeSpan.FromSeconds(seconds);
        while (!condition())
        {
            Token.ThrowIfCancellationRequested();
            if (DateTime.UtcNow > deadline)
                throw new TimeoutException($"{what()} (waited {seconds}s)");
            await SelfTestKit.NextFrame();
        }
    }

