    {
        Add(new SelfTestScenario(name, SelfTestHost.Encounter, body, TimeSpan.FromSeconds(budgetSeconds),
            Enter: t => t.Fight(ModelDb.Encounter<TEncounter>(), keepPlayerHp)));
