{
    internal readonly List<SelfTestScenario> Scenarios = new();
    internal readonly List<Func<EncounterModel>> EncounterModels = new();
    internal readonly List<Func<EventModel>> EventModels = new();
    internal Func<NCharacterSelectButton, bool>? CharacterMatch;
    internal string CharacterLabel = "first unlocked";

    /// <summary>Start the run as this Character instead of the first unlocked one.</summary>
    public SelfTestPlan Character<TCharacter>() where TCharacter : CharacterModel
