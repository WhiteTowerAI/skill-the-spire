    {
        Add(new SelfTestScenario(name, SelfTestHost.Combat, body, TimeSpan.FromSeconds(budgetSeconds),
            freshCombat, Coop: true));
        return this;
    }

    /// <summary>
    /// An enemy scenario: the kit finishes any combat in progress, enters this encounter with its
    /// real roster and HP, and waits for the player's Play phase. It applies no Plating, so enemy
    /// hits land; unless <paramref name="keepPlayerHp"/> is set it raises the player to 999/999 HP
