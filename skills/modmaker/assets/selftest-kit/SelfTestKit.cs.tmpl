/// <summary>Plays a simple Card and compares each number on its face with the observed result.</summary>
internal static class SelfTestFaceCheck
{
    internal static async Task Run<TCard>(SelfTestRun t) where TCard : CardModel
    {
        var canonical = ModelDb.AllCards.OfType<TCard>().First();
        var parts = new List<string> { await Once<TCard>(t, upgraded: false) };
        if (canonical.IsUpgradable)
        {
            await SelfTestKit.ResetCombat(t);
            parts.Add(await Once<TCard>(t, upgraded: true));
        }
        t.Proof(true, string.Join("; ", parts));
    }

    private static async Task<string> Once<TCard>(SelfTestRun t, bool upgraded) where TCard : CardModel
    {
        var label = upgraded ? "upgraded" : "base";
        var card = await t.AddToHand<TCard>(upgraded);
        var vars = card.DynamicVars.Values.ToList();
        if (vars.Any(v => v.GetType() == typeof(HealVar)))
            await t.Do(owner => CreatureCmd.SetCurrentHp(owner.Creature, Math.Max(1, owner.Creature.MaxHp - 40)), "wound for heal");

        var target = card.TargetType == TargetType.AnyEnemy ? t.Enemy : null;
        var enemies = t.Enemies.ToList();
        var hpBefore = enemies.ToDictionary(e => e, e => e.CurrentHp);
        var powersBefore = Powers(t);
        int block = t.Me.Block, hp = t.Me.CurrentHp, maxHp = t.Me.MaxHp, gold = t.Player.Gold;
        int stars = t.Combat.Stars;
        int cost = card.EnergyCost.GetResolved();
        await t.Do(async owner =>
        {
            if (owner.PlayerCombatState!.Energy < cost)
                await PlayerCmd.SetEnergy(cost, owner);
        }, "energy for face check");
        int energy = t.Combat.Energy;
        int drawn = t.Trail.Drawn.Count, spent = t.Trail.EnergySpent;

        await t.Play(card, target);

        var powersAfter = Powers(t);
        int hits = vars.FirstOrDefault(v => v.GetType() == typeof(RepeatVar))?.IntValue ?? 1;
        var ok = new List<string>();
        var bad = new List<string>();
        var skipped = new List<string>();

        void Compare(string name, int expected, int observed)
        {
            (expected == observed ? ok : bad).Add($"{name} expected={expected} observed={observed}");
        }

        foreach (var v in vars)
        {
            var type = v.GetType();
            if (type == typeof(DamageVar))
            {
                int expected = v.IntValue * hits;
                switch (card.TargetType)
                {
                    case TargetType.AnyEnemy:
                        Compare(v.Name, expected, hpBefore[target!] - target!.CurrentHp);
                        break;
                    case TargetType.AllEnemies:
                        foreach (var enemy in enemies)
                            Compare($"{v.Name}@{enemy.Monster?.Id.Entry}", expected, hpBefore[enemy] - enemy.CurrentHp);
                        break;
                    case TargetType.RandomEnemy:
                        Compare(v.Name, expected, enemies.Sum(e => hpBefore[e] - e.CurrentHp));
                        break;
                    default:
                        skipped.Add($"{v.Name} (target {card.TargetType})");
                        break;
                }
            }
            else if (type == typeof(BlockVar))
                Compare(v.Name, v.IntValue, t.Me.Block - block);
            else if (type == typeof(EnergyVar))
                Compare(v.Name, v.IntValue, t.Combat.Energy - (energy - (t.Trail.EnergySpent - spent)));
            else if (type == typeof(CardsVar))
                Compare($"{v.Name} drawn", v.IntValue, t.Trail.Drawn.Count - drawn);
            else if (type == typeof(HealVar))
                Compare(v.Name, v.IntValue, t.Me.CurrentHp - hp);
            else if (type == typeof(HpLossVar))
                Compare(v.Name, v.IntValue, hp - t.Me.CurrentHp);
            else if (type == typeof(MaxHpVar))
                Compare(v.Name, v.IntValue, t.Me.MaxHp - maxHp);
            else if (type == typeof(GoldVar))
                Compare(v.Name, v.IntValue, t.Player.Gold - gold);
            else if (type == typeof(StarsVar))
                Compare(v.Name, v.IntValue, t.Combat.Stars - stars);
            else if (type == typeof(RepeatVar))
                continue;
            else if (SelfTestKit.IsPowerName(v.Name))
            {
                var holders = card.TargetType switch
                {
                    TargetType.AnyEnemy => new List<Creature> { target! },
                    TargetType.AllEnemies => enemies,
                    _ => new List<Creature> { t.Me },
                };
                foreach (var holder in holders)
                {
                    int delta = Amount(powersAfter, holder, v.Name) - Amount(powersBefore, holder, v.Name);
                    Compare(holders.Count > 1 ? $"{v.Name}@{holder.Monster?.Id.Entry}" : v.Name, v.IntValue, delta);
                }
            }
            else
                skipped.Add(v.Name);
        }

        var pile = card.Pile?.Type;
        if (card.Type != CardType.Power)
        {
            var expectedPile = card.Keywords.Contains(CardKeyword.Exhaust) ? PileType.Exhaust : PileType.Discard;
            if (pile == expectedPile)
                ok.Add($"pile={pile}");
            else
                bad.Add($"result pile expected={expectedPile} observed={pile?.ToString() ?? "none"}");
        }
        else if (pile is PileType.Hand or PileType.Play)
            bad.Add($"Power card stuck in {pile} after play");

        if (bad.Count > 0)
            throw new SelfTestProofFailed($"{label}: {string.Join("; ", bad)}");
        var line = $"{label} {(ok.Count > 0 ? string.Join(", ", ok) : "no numbers on face")}";
        return skipped.Count > 0 ? $"{line}; not checked: {string.Join(", ", skipped)}" : line;
    }

    private static Dictionary<(Creature, string), int> Powers(SelfTestRun t)
    {
        var result = new Dictionary<(Creature, string), int>();
        foreach (var creature in t.State.Creatures)
            foreach (var power in creature.Powers)
                result[(creature, power.GetType().Name)] = power.Amount;
        return result;
    }

    private static int Amount(Dictionary<(Creature, string), int> powers, Creature creature, string name)
        => powers.TryGetValue((creature, name), out var amount) ? amount : 0;
}

internal static class SelfTestKit
{
    public const int Version = 1;

    // A scenario that stays stuck this long past its own budget (an await that ignores
    // cancellation) ends the whole run from the watchdog, naming the last step.
    private static readonly TimeSpan StuckGrace = TimeSpan.FromSeconds(10);

    private static bool _armed;
    private static bool _finished;
    private static string _step = "arming";
    private static string? _scenarioName;
    private static DateTime? _scenarioDeadline;
    private static DateTime _runDeadline;
    private static bool _partial;
    private static bool _forceFreshCombat;
    private static readonly List<Outcome> Outcomes = new();
    private static readonly Stopwatch Clock = new();
    private static SelfTestTrail? _trail;
    private static readonly HashSet<Type> PlayedTypes = new();
    private static readonly HashSet<Type> SeenPowerTypes = new();
    private static readonly HashSet<Type> RelicTypes = new();
    private static readonly HashSet<Type> PotionTypes = new();
    private static readonly HashSet<Type> CharacterTypes = new();
    private static readonly HashSet<Type> MonsterTypes = new();
    private static readonly HashSet<Type> EncounterTypes = new();
    internal static readonly HashSet<Type> EventTypes = new();
    internal static readonly HashSet<Type> ActTypes = new();
    private static List<Type> KnownEvents = new();
    private static List<Type> KnownEncounters = new();
    private static HashSet<string>? _powerNames;

    internal static double Seconds => Clock.Elapsed.TotalSeconds;
    private static System.Reflection.Assembly ModAssembly => typeof(SelfTestKit).Assembly;
    private static bool IsMod(object model) => model.GetType().Assembly == ModAssembly;
    private static Node Root => ((SceneTree)Engine.GetMainLoop()).Root;

    internal static void Log(string message) =>
        MainFile.Logger.Info($"[T2MOD-SELFTEST] {MainFile.ModId} {message}");

    /// <summary>Record the step in progress; a failure or a stuck run reports it.</summary>
    internal static void Step(string step) => _step = step;

    private static void ScheduleWatchdog()
    {
        var tree = (SceneTree)Engine.GetMainLoop();
        tree.CreateTimer(1.0).Timeout += () =>
        {
            if (_finished)
                return;
            var now = DateTime.UtcNow;
            if (_scenarioDeadline is { } deadline && now > deadline + StuckGrace)
                Abort($"timeout: scenario {_scenarioName} stuck at '{_step}' past its budget");
            else if (now > _runDeadline + StuckGrace)
                Abort($"timeout: selftest budget exceeded, stuck at '{_step}'");
            else
                ScheduleWatchdog();
        };
    }

    private static void Abort(string reason)
    {
        if (_finished)
            return;
        Report(reason);
    }

    internal static async Task NextFrame()
    {
        var tree = (SceneTree)Engine.GetMainLoop();
        await tree.ToSignal(tree, SceneTree.SignalName.ProcessFrame);
    }

    internal static bool IsPowerName(string name)
    {
        _powerNames ??= ModelDb.AllPowers.Select(p => p.GetType().Name).ToHashSet();
        return _powerNames.Contains(name);
    }

    public static void Arm()
    {
        if (_armed)
            return;
        _armed = true;
        Clock.Start();
        SelfTestNet.Arm(CommandLineHelper.GetValue("t2coop"));

        var plan = new SelfTestPlan();
        string filter;
        List<SelfTestScenario> selected;
        try
        {
            SelfTestScenarios.DefineInto(plan);
            filter = CommandLineHelper.GetValue("t2selftest") ?? "";
            selected = Select(plan, filter);
        }
        catch (Exception e)
        {
            Log($"selftest FAILED: setup: {e.GetType().Name}: {e.Message}");
            return;
        }

        int budget = 120 + selected.Sum(s => (int)s.Budget.TotalSeconds)
            + 15 * selected.Count(s => s.FreshCombat || s.Enter != null || s.Host == SelfTestHost.Custom);
        Log($"selftest budget: {budget}s");
        if (SelfTestNet.Multiplayer)
            Log($"selftest multiplayer role: {SelfTestNet.Role}");
        Log(filter.Length == 0
            ? $"selftest scope: all scenarios={selected.Count}"
            : $"selftest scope: only={filter} selected={selected.Count} of {plan.Scenarios.Count}");
        _partial = filter.Length > 0;
        _runDeadline = DateTime.UtcNow + TimeSpan.FromSeconds(budget);
        Subscribe();
        ScheduleWatchdog();
        _ = RunAsync(plan, selected, TimeSpan.FromSeconds(budget));
    }

    private static List<SelfTestScenario> Select(SelfTestPlan plan, string filter)
    {
        if (filter.Length == 0)
            return plan.Scenarios.ToList();
        var tokens = filter.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        bool Matches(string token, string name) =>
            token.EndsWith('*') ? name.StartsWith(token[..^1], StringComparison.Ordinal) : name == token;
        var unknown = tokens.Where(token => token != "rollcall" && !plan.Scenarios.Any(s => Matches(token, s.Name))).ToList();
        if (unknown.Count > 0)
            throw new ArgumentException($"no scenario matches {string.Join(",", unknown)}; defined: " +
                string.Join(",", plan.Scenarios.Select(s => s.Name).Prepend("rollcall")));
        return plan.Scenarios.Where(s => tokens.Any(token => Matches(token, s.Name))).ToList();
    }

    private static void Subscribe()
    {
        RitsuLibFramework.SubscribeLifecycle<CardPlayedEvent>(e =>
        {
            var card = e.CardPlay.Card;
            if (IsMod(card))
                PlayedTypes.Add(card.GetType());
            _trail?.Played.Add(card);
            _trail?.Note($"played {card.Id.Entry}");
        }, replayCurrentState: false);
        RitsuLibFramework.SubscribeLifecycle<CardDrawnEvent>(e =>
        {
            _trail?.Drawn.Add(e.Card);
            _trail?.Note($"drew {e.Card.Id.Entry}");
        }, replayCurrentState: false);
        RitsuLibFramework.SubscribeLifecycle<CardDiscardedEvent>(e =>
        {
            _trail?.Discarded.Add(e.Card);
            _trail?.Note($"discarded {e.Card.Id.Entry}");
        }, replayCurrentState: false);
        RitsuLibFramework.SubscribeLifecycle<CardExhaustedEvent>(e =>
        {
            _trail?.Exhausted.Add(e.Card);
            _trail?.Note($"exhausted {e.Card.Id.Entry}");
        }, replayCurrentState: false);
        RitsuLibFramework.SubscribeLifecycle<EnergySpentEvent>(e =>
        {
            if (_trail != null)
                _trail.EnergySpent += e.Amount;
            _trail?.Note($"spent {e.Amount} energy");
        }, replayCurrentState: false);
        RitsuLibFramework.SubscribeLifecycle<EnergyGainedEvent>(e =>
        {
            if (_trail != null)
                _trail.EnergyGained += e.Amount;
            _trail?.Note($"gained {e.Amount} energy");
        }, replayCurrentState: false);
        RitsuLibFramework.SubscribeLifecycle<RelicObtainedEvent>(e =>
        {
            if (IsMod(e.Relic))
                RelicTypes.Add(e.Relic.GetType());
            _trail?.RelicsObtained.Add(e.Relic);
            _trail?.Note($"obtained {e.Relic.Id.Entry}");
        }, replayCurrentState: false);
        RitsuLibFramework.SubscribeLifecycle<PotionProcuredEvent>(e =>
        {
            if (IsMod(e.Potion))
                PotionTypes.Add(e.Potion.GetType());
            _trail?.PotionsProcured.Add(e.Potion);
            _trail?.Note($"procured {e.Potion.Id.Entry}");
        }, replayCurrentState: false);
    }

    private sealed record Outcome(string Name, string Result, string Detail, double Seconds);

    private static async Task RunAsync(SelfTestPlan plan, List<SelfTestScenario> selected, TimeSpan budget)
    {
        using var cts = new CancellationTokenSource(budget);
        var ct = cts.Token;
        string? setupFailure = null;
        try
        {
            Step("waiting for the main menu");
            await WaitHelper.Until(() => NGame.Instance != null, ct, TimeSpan.FromSeconds(30), "no NGame");
            await WaitHelper.ForNode<Control>(Root, "/root/Game/RootSceneContainer/MainMenu", ct, TimeSpan.FromSeconds(60));
            await WaitHelper.Until(() => LocManager.Instance != null, ct, TimeSpan.FromSeconds(30), "LocManager not ready");
            Log($"stage: main menu t={Seconds:F1}s");

            Step("roll call");
            Outcomes.Add(RollCall(plan));
            Log($"stage: roll call t={Seconds:F1}s");

            if (selected.Count > 0)
            {
                Step("navigating to a run");
                var player = SelfTestNet.Multiplayer
                    ? await NavigateToMultiplayerRunAsync(plan, ct)
                    : await NavigateToRunAsync(plan, ct);
                Log($"stage: run started as {plan.CharacterLabel} t={Seconds:F1}s");
                if (IsMod(player.Character))
                    CharacterTypes.Add(player.Character.GetType());
                NoteOwned(player);
                // RunStart scenarios see the run before any combat changes it.
                var ordered = selected.Where(s => s.Host == SelfTestHost.RunStart)
                    .Concat(selected.Where(s => s.Host is not (SelfTestHost.RunStart or SelfTestHost.Act)))
                    .Concat(selected.Where(s => s.Host == SelfTestHost.Act));
                foreach (var scenario in ordered)
                {
                    var outcome = await RunScenario(scenario, player, ct);
                    if (_finished)
                        return;
                    Outcomes.Add(outcome);
                }
            }
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            setupFailure = $"timeout: selftest budget {(int)budget.TotalSeconds}s exceeded at '{_step}'";
        }
        catch (Exception e)
        {
            setupFailure = $"setup: {e.GetType().Name}: {e.Message} at '{_step}'";
        }
        if (!_finished)
            Report(setupFailure);
    }

    private static async Task<Outcome> RunScenario(SelfTestScenario scenario, Player player, CancellationToken outer)
    {
        var watch = Stopwatch.StartNew();
        using var cts = CancellationTokenSource.CreateLinkedTokenSource(outer);
        cts.CancelAfter(scenario.Budget);
        // A Coop scenario acts for each peer's own player.
        var actor = scenario.Coop && SelfTestNet.Multiplayer ? SelfTestNet.LocalPlayer() : player;
        var t = new SelfTestRun(actor, cts.Token, scenario.Name, scenario.Coop);
        _trail = t.Trail;
        _scenarioName = scenario.Name;
        _scenarioDeadline = DateTime.UtcNow + scenario.Budget;
        Log($"scenario start: {scenario.Name}");
        SelfTestNet.BeginScenario(scenario.Name);
        var skip = SkipReason(scenario);
        if (skip != null)
        {
            _scenarioDeadline = null;
            _trail = null;
            Log($"scenario SKIP: {scenario.Name}: {skip}");
            return new Outcome(scenario.Name, "SKIP", skip, 0);
        }
        string result = "PASS", detail = "";
        try
        {
            if (scenario.Host == SelfTestHost.RunStart)
            {
                // Nothing to prepare: the run is exactly as it started.
            }
            else if (scenario.Host == SelfTestHost.Custom)
            {
                _forceFreshCombat = true;
                if (CombatManager.Instance.IsInProgress)
                    await FinishCombat(t);
            }
            else if (scenario.Enter != null)
            {
                // Encounter, Event, Ancient, Rest Site, and Act hosts.
                _forceFreshCombat = true;
                if (CombatManager.Instance.IsInProgress)
                    await FinishCombat(t);
                if (scenario.BeforeCombat != null)
                {
                    Step($"{scenario.Name} beforeEnter");
                    await scenario.BeforeCombat(t);
                }
                await scenario.Enter(t);
            }
            else if (scenario.FreshCombat)
            {
                // Asked for: keep the host's opening Hand, Energy, and Powers for the body to assert.
                await EnterFreshCombat(t, scenario.BeforeCombat);
                _forceFreshCombat = false;
            }
            else
            {
                // A combat the kit needs on its own starts from the same reset state as any other.
                if (_forceFreshCombat || !CombatUsable(player))
                    await EnterFreshCombat(t, null);
                _forceFreshCombat = false;
                await ResetCombat(t);
            }
            Step($"{scenario.Name} body");
            SelfTestNet.Phase = "body";
            await scenario.Body(t);
            await t.Settle();
            if (SelfTestNet.Multiplayer)
            {
                // Both peers log this at the same queue position; launch.py compares them.
                Step($"{scenario.Name} digest");
                SelfTestNet.Phase = "digest";
                await SelfTestNet.Step<object?>("digest", player, _ =>
                {
                    Log($"selftest digest: {scenario.Name}: {SelfTestNet.Digest()}");
                    return Task.FromResult<object?>(null);
                }, false, t.Token);
            }
        }
        catch (SelfTestProofFailed e)
        {
            result = "FAIL";
            detail = e.Message;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested && !outer.IsCancellationRequested)
        {
            result = "TIMEOUT";
            detail = $"scenario budget {(int)scenario.Budget.TotalSeconds}s exceeded at '{_step}'";
        }
        catch (Exception e) when (!outer.IsCancellationRequested)
        {
            result = "ERROR";
            detail = $"{e.GetType().Name}: {e.Message} at '{_step}'";
        }
        finally
        {
            _scenarioDeadline = null;
            _trail = null;
            foreach (var creature in CombatManager.Instance.DebugOnlyGetState()?.Creatures ?? Enumerable.Empty<Creature>())
            {
                foreach (var power in creature.Powers.Where(IsMod))
                    SeenPowerTypes.Add(power.GetType());
                if (creature.Monster is { } monster && IsMod(monster))
                    MonsterTypes.Add(monster.GetType());
            }
            NoteOwned(player);
            await Cleanup(t);
        }
        var seconds = watch.Elapsed.TotalSeconds;
        if (result == "PASS")
            Log($"scenario PASS: {scenario.Name} ({seconds:F1}s)");
        else
        {
            Log($"scenario FAILED: {scenario.Name}: {result}: {detail} ({seconds:F1}s)");
            foreach (var line in t.Trail.Lines)
                Log($"scenario trail: {scenario.Name}: {line}");
        }
        return new Outcome(scenario.Name, result, detail, seconds);
    }

    private static bool CombatUsable(Player player) =>
        CombatManager.Instance.IsInProgress &&
        (CombatManager.Instance.DebugOnlyGetState()?.HittableEnemies.Any() ?? false) &&
        player.PlayerCombatState?.Phase == PlayerTurnPhase.Play;

    internal static NRestSiteRoom? RestSiteRoom()
        => Root.GetNodeOrNull<NRestSiteRoom>("/root/Game/RootSceneContainer/Run/RoomContainer/RestSiteRoom");

    internal static async Task EnterFreshCombat(SelfTestRun t, Func<SelfTestRun, Task>? beforeCombat)
    {
        if (CombatManager.Instance.IsInProgress)
            await FinishCombat(t);
        if (beforeCombat != null)
        {
            Step($"{t.Name} beforeCombat");
            await beforeCombat(t);
        }
        Step("entering combat");
        await Shared(t, "enter combat", async () =>
        {
            var encounter = ModelDb.Encounter<CorpseSlugsWeak>().ToMutable();
            await RunManager.Instance.EnterRoomDebug(RoomType.Monster, MapPointType.Unassigned, encounter);
        });
        Step("waiting for combat to start");
        await WaitHelper.Until(() => CombatManager.Instance.IsInProgress, t.Token,
            TimeSpan.FromSeconds(30), "combat not started");
        Step("applying Plating");
        // Every player: in multiplayer the enemies may hit either one.
        await Shared(t, "plating", async () =>
        {
            foreach (var creature in t.State.Players.Select(p => p.Creature).ToList())
                await PowerCmd.Apply<PlatingPower>(new ThrowingPlayerChoiceContext(), creature, 999m, creature, null);
        });
        Step("waiting for the Play phase");
        var local = SelfTestNet.Multiplayer ? SelfTestNet.LocalPlayer() : t.Player;
        await WaitHelper.Until(
            () => local.PlayerCombatState?.Phase == PlayerTurnPhase.Play || !CombatManager.Instance.IsInProgress,
            t.Token, TimeSpan.FromSeconds(30), "play phase not reached");
        Step("settling after combat start");
        await t.Settle();
        Step("preparing enemies");
        await Shared(t, "prepare enemies", () => PrepareEnemies(t));
        Log($"stage: combat ready for {t.Name} t={Seconds:F1}s");
    }

    internal static Type? CurrentActType()
    {
        var act = RunManager.Instance.DebugOnlyGetState()?.Act;
        return act != null && IsMod(act) ? act.GetType() : null;
    }

    internal static bool IsModModel(object model) => IsMod(model);

    // Starting Relics and Potions are owned without an obtain event.
    private static void NoteOwned(Player player)
    {
        foreach (var relic in player.Relics.Where(IsMod))
            RelicTypes.Add(relic.GetType());
        foreach (var potion in player.PotionSlots)
        {
            if (potion is { } owned && IsMod(owned))
                PotionTypes.Add(owned.GetType());
        }
    }

    internal static async Task EnterEncounter(SelfTestRun t, EncounterModel canonical, bool keepPlayerHp)
    {
        if (CombatManager.Instance.IsInProgress)
            await FinishCombat(t);
        var id = canonical.Id.Entry;
        Step($"entering {id}");
        await Shared(t, $"enter {id}", async () =>
        {
            var encounter = canonical.ToMutable();
            await RunManager.Instance.EnterRoomDebug(RoomType.Monster, MapPointType.Unassigned, encounter);
        });
        await WaitHelper.Until(() => CombatManager.Instance.IsInProgress, t.Token,
            TimeSpan.FromSeconds(30), $"{id} combat not started");
        if (IsMod(canonical))
            EncounterTypes.Add(canonical.GetType());
        if (CurrentActType() is { } act)
            ActTypes.Add(act);
        Step($"waiting for the Play phase in {id}");
        var local = SelfTestNet.Multiplayer ? SelfTestNet.LocalPlayer() : t.Player;
        await WaitHelper.Until(
            () => local.PlayerCombatState?.Phase == PlayerTurnPhase.Play || !CombatManager.Instance.IsInProgress,
            t.Token, TimeSpan.FromSeconds(30), "play phase not reached");
        await t.Settle();
        if (!keepPlayerHp)
        {
            await Shared(t, "player hp 999", async () =>
            {
                foreach (var creature in t.State.Players.Select(p => p.Creature).ToList())
                {
                    await CreatureCmd.SetMaxHp(creature, 999m);
                    await CreatureCmd.SetCurrentHp(creature, 999m);
                }
            });
        }
        Log($"stage: {id} ready for {t.Name} t={Seconds:F1}s");
    }

    internal static async Task FinishCombat(SelfTestRun t)
    {
        Step("finishing the previous combat");
        await Shared(t, "finish combat", async () =>
        {
            var alive = t.State.Enemies.Where(enemy => enemy.IsAlive).ToList();
            await CreatureCmd.Kill(alive, force: true);
            await CombatManager.Instance.CheckWinCondition();
        });
        await WaitHelper.Until(() => !CombatManager.Instance.IsInProgress, t.Token,
            TimeSpan.FromSeconds(30), "previous combat did not finish");
        if (SelfTestNet.Multiplayer)
        {
            // Each peer offers room-end rewards after its own death animations, and generating them
            // draws RNG, so no peer may leave the room before every peer has generated them.
            await WaitHelper.Until(() => t.Run.CurrentRoom is not CombatRoom { Encounter.ShouldGiveRewards: true } ||
                                         (NOverlayStack.Instance?.ScreenCount ?? 0) > 0,
                t.Token, TimeSpan.FromSeconds(20), "the combat rewards were never offered on this peer");
            await SelfTestNet.Step<object?>("rewards offered", t.Player, _ => Task.FromResult<object?>(null), true, t.Token);
        }
    }

    /// <summary>Between scenarios in one combat: clear the Hand, player Powers, Block, HP, Energy, and enemies.</summary>
    internal static async Task ResetCombat(SelfTestRun t)
    {
        Step($"resetting combat for {t.Name}");
        await t.Settle();
        await Shared(t, "reset combat", async () =>
        {
            // Every player, so a Coop scenario starts both from the same state.
            foreach (var player in t.State.Players.ToList())
            {
                var me = player.Creature;
                var combat = player.PlayerCombatState!;
                foreach (var card in combat.Hand.Cards.ToList())
                {
                    if (t.CreatedCards.Contains(card))
                        await CardPileCmd.RemoveFromCombat(card, skipVisuals: true);
                    else
                        await CardPileCmd.Add(card, PileType.Draw, skipVisuals: true);
                }
                foreach (var power in me.Powers.Where(p => p is not PlatingPower).ToList())
                    await PowerCmd.Remove(power);
                if (me.Block > 0)
                    await CreatureCmd.LoseBlock(me, me.Block);
                if (me.CurrentHp < me.MaxHp)
                    await CreatureCmd.SetCurrentHp(me, me.MaxHp);
                await PlayerCmd.SetEnergy(combat.MaxEnergy, player);
            }
            await PrepareEnemies(t);
        });
        await t.Settle();
    }

    private static async Task PrepareEnemies(SelfTestRun t)
    {
        foreach (var enemy in t.State.Enemies.Where(e => e.IsAlive).ToList())
        {
            foreach (var power in enemy.Powers.ToList())
                await PowerCmd.Remove(power);
            if (enemy.Block > 0)
                await CreatureCmd.LoseBlock(enemy, enemy.Block);
            await CreatureCmd.SetMaxHp(enemy, 999m);
            await CreatureCmd.SetCurrentHp(enemy, 999m);
        }
    }

    /// <summary>
    /// Kit setup every peer runs once, in queue order: the host requests it in multiplayer, also
    /// in a Coop scenario. Singleplayer runs it at once.
    /// </summary>
    private static Task Shared(SelfTestRun t, string label, Func<Task> body)
        => SelfTestNet.Step<object?>(label, t.Player, async _ => { await body(); return null; }, false, t.Token);

    private static string? SkipReason(SelfTestScenario scenario)
    {
        if (scenario.Coop && !SelfTestNet.Multiplayer)
            return "multiplayer only; run launch.py --self-test --multiplayer";
        if (SelfTestNet.Multiplayer && scenario.Host is SelfTestHost.Event or SelfTestHost.Ancient
                or SelfTestHost.RestSite or SelfTestHost.Act or SelfTestHost.Custom)
            return $"the {scenario.Host} host has no multiplayer driver yet; its singleplayer run is the proof";
        return null;
    }

    private static async Task Cleanup(SelfTestRun t)
    {
        try
        {
            SelfTestNet.Phase = "cleanup";
            await Shared(t, "cleanup", async () =>
            {
                foreach (var (owner, type) in t.OwnedRelics)
                {
                    if (owner.Relics.LastOrDefault(r => r.GetType() == type) is { } relic)
                        await RelicCmd.Remove(relic);
                }
                foreach (var (owner, type) in t.OwnedPotions)
                {
                    if (owner.PotionSlots.LastOrDefault(p => p?.GetType() == type) is { } potion)
                        await PotionCmd.Discard(potion);
                }
            });
        }
        catch (Exception e)
        {
            Log($"scenario note: {t.Name}: cleanup failed: {e.GetType().Name}: {e.Message}");
        }
    }

    private static async Task<Player> NavigateToRunAsync(SelfTestPlan plan, CancellationToken ct)
    {
        var mainMenu = await WaitHelper.ForNode<Control>(Root, "/root/Game/RootSceneContainer/MainMenu", ct, TimeSpan.FromSeconds(30));
        var abandon = mainMenu.GetNode<NButton>("MainMenuTextButtons/AbandonRunButton");
        if (abandon.Visible)
        {
            await UiHelper.Click(abandon);
            await WaitHelper.Until(() => NModalContainer.Instance?.OpenModal != null, ct, TimeSpan.FromSeconds(10), "no abandon modal");
            var modal = (Node)NModalContainer.Instance!.OpenModal!;
            await UiHelper.Click(modal.GetNode<NButton>("VerticalPopup/YesButton"));
            await WaitHelper.Until(() => NModalContainer.Instance.OpenModal == null, ct, TimeSpan.FromSeconds(10), "abandon modal stuck");
        }

        await UiHelper.Click(mainMenu.GetNode<NButton>("MainMenuTextButtons/SingleplayerButton"));
        Control? charSelect = null;
        NButton? standard = null;
        await WaitHelper.Until(() =>
        {
            charSelect = mainMenu.GetNodeOrNull<Control>("Submenus/CharacterSelectScreen");
            standard = mainMenu.GetNodeOrNull<NButton>("Submenus/SingleplayerSubmenu/StandardButton");
            return (charSelect?.Visible ?? false) || (standard?.Visible ?? false);
        }, ct, TimeSpan.FromSeconds(10), "neither submenu nor char select");
        if ((standard?.Visible ?? false) && !(charSelect?.Visible ?? false))
        {
            await UiHelper.Click(standard);
            await WaitHelper.Until(() => mainMenu.GetNodeOrNull<Control>("Submenus/CharacterSelectScreen")?.Visible ?? false,
                ct, TimeSpan.FromSeconds(10), "char select never showed");
            charSelect = mainMenu.GetNode<Control>("Submenus/CharacterSelectScreen");
        }

        var buttons = UiHelper.FindAll<NCharacterSelectButton>(charSelect!.GetNode("CharSelectButtons/ButtonContainer"));
        foreach (var button in buttons)
            button.UnlockIfPossible();
        var pick = plan.CharacterMatch != null
            ? buttons.FirstOrDefault(b => plan.CharacterMatch(b))
            : buttons.FirstOrDefault(b => !b.IsLocked);
        if (pick == null || pick.IsLocked)
            throw new InvalidOperationException($"character {plan.CharacterLabel} has no unlocked select button");
        pick.Select();
        await NextFrame();
        await UiHelper.Click(await WaitHelper.ForNode<NButton>(mainMenu, "Submenus/CharacterSelectScreen/ConfirmButton", ct, TimeSpan.FromSeconds(10)));

        await WaitHelper.Until(() => RunManager.Instance.IsInProgress, ct, TimeSpan.FromSeconds(30), "run not in progress");
        // EnterRoomDebug touches NRun.GlobalUi, which is wired in NRun._Ready after IsInProgress.
        await WaitHelper.Until(() => NRun.Instance?.GlobalUi != null, ct, TimeSpan.FromSeconds(30), "run UI not ready");
        Player? player = null;
        await WaitHelper.Until(() => (player = LocalContext.GetMe(RunManager.Instance.DebugOnlyGetState())) != null,
            ct, TimeSpan.FromSeconds(30), "local player missing");
        // The run is still entering its first room (Neow or the map); a debug room entry before that
        // races the game's own startup.
        await WaitHelper.Until(() => RunManager.Instance.DebugOnlyGetState()?.Map is not NullActMap &&
                                     (NRun.Instance?.EventRoom?.Layout != null || NRun.Instance?.MapRoom != null),
            ct, TimeSpan.FromSeconds(30), "the run's first room did not finish loading");
        return player!;
    }

    /// <summary>
    /// launch.py --multiplayer starts the host with --fastmp=host_standard and the client with
    /// --fastmp=join, so the game itself opens the local multiplayer Character select. Both pick
    /// the plan's Character, ready up, and wait for a two-player run. Returns the acting player:
    /// the host's, on both peers.
    /// </summary>
    private static async Task<Player> NavigateToMultiplayerRunAsync(SelfTestPlan plan, CancellationToken ct)
    {
        const string path = "/root/Game/RootSceneContainer/MainMenu/Submenus/CharacterSelectScreen";
        NCharacterSelectScreen? screen = null;
        await WaitHelper.Until(() => (screen = Root.GetNodeOrNull<NCharacterSelectScreen>(path)) is { Visible: true, Lobby: not null },
            ct, TimeSpan.FromSeconds(120), "the multiplayer Character select never opened (launch with launch.py --multiplayer)");
        var lobby = screen!.Lobby;
        var expected = SelfTestNet.IsHost ? NetGameType.Host : NetGameType.Client;
        if (lobby.NetService.Type != expected)
            throw new InvalidOperationException($"this peer is {lobby.NetService.Type}, expected {expected}");
        if (SelfTestNet.IsHost)
            Log("selftest multiplayer lobby open");
        await WaitHelper.Until(() => lobby.Players.Count >= 2, ct, TimeSpan.FromSeconds(120), "the second player never joined");
        Log($"stage: lobby players={string.Join(",", lobby.Players.Select(p => p.id))} t={Seconds:F1}s");

        var buttons = UiHelper.FindAll<NCharacterSelectButton>(screen.GetNode("CharSelectButtons/ButtonContainer"));
        foreach (var button in buttons)
            button.UnlockIfPossible();
        var pick = plan.CharacterMatch != null
            ? buttons.FirstOrDefault(b => plan.CharacterMatch(b))
            : buttons.FirstOrDefault(b => !b.IsLocked);
        if (pick == null || pick.IsLocked)
            throw new InvalidOperationException($"character {plan.CharacterLabel} has no unlocked select button");
        pick.Select();
        await NextFrame();
        await UiHelper.Click(await WaitHelper.ForNode<NButton>(screen, "ConfirmButton", ct, TimeSpan.FromSeconds(10)));
        await WaitHelper.Until(() => lobby.LocalPlayer.isReady || RunManager.Instance.IsInProgress, ct,
            TimeSpan.FromSeconds(10), "Confirm did not ready the local player");

        await WaitHelper.Until(() => RunManager.Instance.IsInProgress, ct, TimeSpan.FromSeconds(90), "run not in progress");
        await WaitHelper.Until(() => NRun.Instance?.GlobalUi != null, ct, TimeSpan.FromSeconds(30), "run UI not ready");
        await WaitHelper.Until(() => RunManager.Instance.DebugOnlyGetState() is { Players.Count: 2 } run &&
                                     LocalContext.GetMe(run) != null,
            ct, TimeSpan.FromSeconds(30), "the run does not have two players");
        await WaitHelper.Until(() => RunManager.Instance.DebugOnlyGetState()?.Map is not NullActMap &&
                                     (NRun.Instance?.EventRoom?.Layout != null || NRun.Instance?.MapRoom != null),
            ct, TimeSpan.FromSeconds(60), "the run's first room did not finish loading");
        var players = RunManager.Instance.DebugOnlyGetState()!.Players;
        var me = SelfTestNet.LocalPlayer();
        var actor = SelfTestNet.IsHost ? me : players.First(p => p != me);
        SelfTestNet.HostNetId = actor.NetId;
        Log($"stage: multiplayer run players={string.Join(",", players.Select(p => $"{p.NetId}:{p.Character.Id.Entry}"))} " +
            $"me={me.NetId} actor={actor.NetId}");
        return actor;
    }

    // ----- roll call: registration, pools, and text in both languages for every Mod model -----

    private static Outcome RollCall(SelfTestPlan plan)
    {
        var watch = Stopwatch.StartNew();
        var cards = ModelDb.AllCards.Where(IsMod).ToList();
        var relics = ModelDb.AllRelics.Where(IsMod).ToList();
        var potions = ModelDb.AllPotions.Where(IsMod).ToList();
        var powers = ModelDb.AllPowers.Where(IsMod).ToList();
        var characters = ModelDb.AllCharacters.Where(IsMod).ToList();
        var monsters = ModelDb.Monsters.Where(IsMod).ToList();
        // ModelDb.AllEncounters lists only Act encounters; add the ones scenarios name.
        var encounters = ModelDb.AllEncounters.Where(IsMod)
            .Concat(plan.EncounterModels.Select(model => model()))
            .GroupBy(model => model.GetType()).Select(group => group.First()).ToList();
        KnownEncounters = encounters.Select(model => model.GetType()).ToList();
        var events = ModelDb.AllEvents.Where(IsMod).Concat(ModelDb.AllAncients.Where(IsMod))
            .Concat(plan.EventModels.Select(model => model()))
            .GroupBy(model => model.GetType()).Select(group => group.First()).ToList();
        KnownEvents = events.Select(model => model.GetType()).ToList();
        var acts = ModelDb.Acts.Where(IsMod).ToList();
        var problems = new List<string>();
        // Every concrete model class this Mod defines must be registered through its content pack.
        // The game discovers unregistered model classes too, but gives them a vanilla-style id
        // without this Mod's stem, so their localization keys never resolve.
        var stem = STS2RitsuLib.Content.ModContentRegistry.NormalizePublicStem(MainFile.ModId) + "_";
        foreach (var type in ModAssembly.GetTypes().Where(type =>
                     !type.IsAbstract && !type.IsGenericTypeDefinition && PrefixedKinds.Any(kind => kind.IsAssignableFrom(type))))
        {
            var entry = ModelDb.Contains(type) ? ModelDb.GetId(type).Entry : null;
            if (entry == null || !entry.StartsWith(stem, StringComparison.Ordinal))
                problems.Add($"{type.Name} is not registered by this Mod's content pack (id {entry ?? "none"}, expected a {stem} prefix)");
        }
        var titles = new Dictionary<AbstractModel, List<string>>();

        // The native Ancient room picks one valid dialogue per visit and throws when none is left.
        foreach (var ancient in events.OfType<AncientEventModel>())
        {
            foreach (var character in ModelDb.AllCharacters)
            {
                foreach (var visits in new[] { 0, 20 })
                {
                    try
                    {
                        if (!ancient.DialogueSet.GetValidDialogues(character.Id, visits, visits, true).Any())
                            problems.Add($"{ancient.Id.Entry} has no valid dialogue for {character.Id.Entry} at visit {visits + 1}" +
                                (visits > 0 ? "; add a repeating (r) dialogue group" : ""));
                    }
                    catch (Exception e)
                    {
                        problems.Add($"{ancient.Id.Entry} dialogue for {character.Id.Entry} failed: {e.GetType().Name}: {e.Message}");
                    }
                }
            }
        }

        var loc = LocManager.Instance;
        var original = loc.Language;
        try
        {
            foreach (var language in new[] { "eng", "zhs" })
            {
                loc.SetLanguage(language);
                void Check(AbstractModel model, string field, Func<string> text, string key)
                {
                    try
                    {
                        var value = text();
                        if (string.IsNullOrWhiteSpace(value))
                            problems.Add($"{language} {model.Id.Entry}.{field} is empty");
                        else if (value.Contains(key, StringComparison.Ordinal))
                            problems.Add($"{language} {model.Id.Entry}.{field} shows its raw key");
                        else if (value.Contains('{') || value.Contains('}'))
                            problems.Add($"{language} {model.Id.Entry}.{field} has an unresolved placeholder: {Clip(value)}");
                        if (field is "title" or "name")
                        {
                            if (!titles.TryGetValue(model, out var list))
                                titles[model] = list = new List<string>();
                            list.Add($"{language}='{value}'");
                        }
                    }
                    catch (Exception e)
                    {
                        problems.Add($"{language} {model.Id.Entry}.{field} failed: {e.GetType().Name}: {e.Message}");
                    }
                }
                // Keys whose placeholders only their consumer fills ({character}, {encounter}).
                void CheckRaw(string table, string key)
                {
                    if (!LocString.Exists(table, key))
                        problems.Add($"{language} {table}/{key} is missing");
                    else if (string.IsNullOrWhiteSpace(new LocString(table, key).GetRawText()))
                        problems.Add($"{language} {table}/{key} is empty");
                }
                void CheckLoc(AbstractModel model, string field, LocString value)
                {
                    if (!value.Exists())
                        problems.Add($"{language} {value.LocTable}/{value.LocEntryKey} is missing");
                    else
                        Check(model, field, value.GetFormattedText, value.LocEntryKey);
                }

                foreach (var card in cards)
                {
                    CheckLoc(card, "title", card.TitleLocString);
                    if (!card.Description.Exists())
                        problems.Add($"{language} cards/{card.Id.Entry}.description is missing");
                    else
                        Check(card, "description", () => card.GetDescriptionForPile(PileType.None), card.Id.Entry + ".description");
                    var prompt = new LocString("cards", card.Id.Entry + ".selectionScreenPrompt");
                    if (prompt.Exists())
                    {
                        card.DynamicVars.AddTo(prompt);
                        Check(card, "selectionScreenPrompt", prompt.GetFormattedText, prompt.LocEntryKey);
                    }
                }
                foreach (var relic in relics)
                {
                    CheckLoc(relic, "title", relic.Title);
                    CheckLoc(relic, "description", relic.DynamicDescription);
                    CheckLoc(relic, "flavor", relic.Flavor);
                }
                foreach (var potion in potions)
                {
                    CheckLoc(potion, "title", potion.Title);
                    CheckLoc(potion, "description", potion.DynamicDescription);
                }
                foreach (var character in characters)
                {
                    CheckLoc(character, "title", character.Title);
                    CheckLoc(character, "description", new LocString("characters", character.Id.Entry + ".description"));
                    foreach (var suffix in CharacterKeys)
                        CheckRaw("characters", character.Id.Entry + "." + suffix);
                }
                foreach (var monster in monsters)
                    CheckLoc(monster, "name", new LocString("monsters", monster.Id.Entry + ".name"));
                foreach (var encounter in encounters)
                {
                    CheckLoc(encounter, "title", new LocString("encounters", encounter.Id.Entry + ".title"));
                    CheckRaw("encounters", encounter.Id.Entry + ".loss");
                }
                foreach (var model in events)
                {
                    CheckLoc(model, "title", model.Title);
                    CheckLoc(model, "description", model.InitialDescription);
                    if (model is AncientEventModel ancient)
                        CheckLoc(model, "epithet", ancient.Epithet);
                }
                foreach (var act in acts)
                    CheckLoc(act, "title", new LocString("acts", act.Id.Entry + ".title"));
                foreach (var power in powers)
                {
                    CheckLoc(power, "title", power.Title);
                    CheckLoc(power, "description", power.Description);
                    // The live Power binds {Amount} when its tooltip renders; bind the canonical 0 the same way.
                    var smart = power.SmartDescription;
                    smart.Add("Amount", power.Amount);
                    CheckLoc(power, "smartDescription", smart);
                }
            }
        }
        finally
        {
            if (loc.Language != original)
                loc.SetLanguage(original);
        }

        string Titles(AbstractModel model) => titles.TryGetValue(model, out var list) ? string.Join(" ", list) : "";
        var cardPools = ModelDb.AllCardPools.ToList();
        foreach (var card in cards)
        {
            var pools = cardPools.Where(pool => pool.AllCards.Contains(card)).Select(pool => pool.GetType().Name).ToList();
            string cost;
            try { cost = card.EnergyCost.GetResolved().ToString(); }
            catch (Exception) { cost = "?"; }
            var vars = string.Join(",", card.DynamicVars.Values.Select(v => $"{v.Name}={v.BaseValue:0.##}"));
            Log($"roll call: card {card.GetType().Name} id={card.Id.Entry} pool={(pools.Count > 0 ? string.Join("+", pools) : "none")} " +
                $"cost={cost} type={card.Type} rarity={card.Rarity} target={card.TargetType} vars={(vars.Length > 0 ? vars : "none")} {Titles(card)}");
        }
        var relicPools = ModelDb.AllRelicPools.ToList();
        foreach (var relic in relics)
        {
            var pools = relicPools.Where(pool => pool.AllRelics.Contains(relic)).Select(pool => pool.GetType().Name).ToList();
            Log($"roll call: relic {relic.GetType().Name} id={relic.Id.Entry} pool={(pools.Count > 0 ? string.Join("+", pools) : "none")} rarity={relic.Rarity} {Titles(relic)}");
        }
        var potionPools = ModelDb.AllPotionPools.ToList();
        foreach (var potion in potions)
        {
            var pools = potionPools.Where(pool => pool.AllPotions.Contains(potion)).Select(pool => pool.GetType().Name).ToList();
            Log($"roll call: potion {potion.GetType().Name} id={potion.Id.Entry} pool={(pools.Count > 0 ? string.Join("+", pools) : "none")} {Titles(potion)}");
        }
        foreach (var power in powers)
            Log($"roll call: power {power.GetType().Name} id={power.Id.Entry} type={power.Type} {Titles(power)}");
        string Names(IEnumerable<AbstractModel> models) => string.Join(",", models
            .GroupBy(model => model.GetType().Name).OrderBy(group => group.Key, StringComparer.Ordinal)
            .Select(group => group.Count() > 1 ? $"{group.Key}x{group.Count()}" : group.Key));
        foreach (var character in characters)
        {
            Log($"roll call: character {character.GetType().Name} id={character.Id.Entry} hp={character.StartingHp} " +
                $"gold={character.StartingGold} energy={character.MaxEnergy} " +
                $"cardPool={character.CardPool.GetType().Name}({character.CardPool.AllCards.Count()}) " +
                $"relicPool={character.RelicPool.GetType().Name}({character.RelicPool.AllRelics.Count()}) " +
                $"potionPool={character.PotionPool.GetType().Name}({character.PotionPool.AllPotions.Count()}) " +
                $"deck={Names(character.StartingDeck)} relics={Names(character.StartingRelics)} {Titles(character)}");
        }
        foreach (var monster in monsters)
            Log($"roll call: monster {monster.GetType().Name} id={monster.Id.Entry} " +
                $"hp={monster.MinInitialHp}-{monster.MaxInitialHp} {Titles(monster)}");
        foreach (var encounter in encounters)
            Log($"roll call: encounter {encounter.GetType().Name} id={encounter.Id.Entry} room={encounter.RoomType} " +
                $"monsters={Names(encounter.AllPossibleMonsters)} {Titles(encounter)}");
        foreach (var model in events)
            Log($"roll call: {(model is AncientEventModel ? "ancient" : "event")} {model.GetType().Name} id={model.Id.Entry} {Titles(model)}");
        foreach (var act in acts)
            Log($"roll call: act {act.GetType().Name} id={act.Id.Entry} index={act.Index} weak={act.AllWeakEncounters.Count()} " +
                $"regular={act.AllRegularEncounters.Count()} elite={act.AllEliteEncounters.Count()} boss={act.AllBossEncounters.Count()} " +
                $"events={act.AllEvents.Count()} ancients={act.AllAncients.Count()} {Titles(act)}");

        var seconds = watch.Elapsed.TotalSeconds;
        var summary = $"cards={cards.Count} relics={relics.Count} potions={potions.Count} powers={powers.Count} " +
            $"characters={characters.Count} monsters={monsters.Count} encounters={encounters.Count} " +
            $"events={events.Count} acts={acts.Count} text=eng,zhs";
        if (problems.Count == 0)
        {
            Log($"state proof: rollcall: {summary}");
            Log($"scenario PASS: rollcall ({seconds:F1}s)");
            return new Outcome("rollcall", "PASS", summary, seconds);
        }
        var detail = $"{problems.Count} problem(s): {string.Join("; ", problems.Take(8))}";
        Log($"scenario FAILED: rollcall: FAIL: {detail} ({seconds:F1}s)");
        return new Outcome("rollcall", "FAIL", detail, seconds);
    }

    // Content kinds RitsuLib registers under the Mod's stem. Pools and other helper models keep
    // vanilla-style ids even when registered.
    private static readonly Type[] PrefixedKinds =
    {
        typeof(CardModel), typeof(RelicModel), typeof(PotionModel), typeof(PowerModel), typeof(CharacterModel),
        typeof(MonsterModel), typeof(EncounterModel), typeof(EventModel), typeof(ActModel), typeof(OrbModel),
        typeof(EnchantmentModel), typeof(AfflictionModel),
    };

    // The flat characters.json keys every Character ships (recipes/character.md).
    private static readonly string[] CharacterKeys =
    {
        "title", "titleObject", "description", "pronounObject", "possessiveAdjective", "pronounPossessive",
        "pronounSubject", "goldMonologue", "eventDeathPrevention", "aromaPrinciple", "cardsModifierTitle",
        "cardsModifierDescription", "banter.alive.endTurnPing", "banter.dead.endTurnPing",
    };

    private static string Clip(string text) => text.Length <= 80 ? text : text[..80] + "...";

    private static void Report(string? setupFailure)
    {
        if (_finished)
            return;
        _finished = true;
        var outcomes = Outcomes;
        var scope = _partial ? "partial" : "all";
        string CoveredTypes(string label, IReadOnlyCollection<Type> mine, HashSet<Type> seen)
        {
            var missing = mine.Where(type => !seen.Contains(type)).Select(type => type.Name).ToList();
            return $"{label} {mine.Count - missing.Count}/{mine.Count}" +
                (missing.Count > 0 ? $" (not exercised: {string.Join(",", missing)})" : "");
        }
        string Covered<T>(string label, IEnumerable<T> models, HashSet<Type> seen) where T : AbstractModel
            => CoveredTypes(label, models.Where(IsMod).Select(m => m.GetType()).Distinct().ToList(), seen);
        Log("selftest coverage: " + string.Join("; ",
            Covered("cards played", ModelDb.AllCards, PlayedTypes),
            Covered("relics owned", ModelDb.AllRelics, RelicTypes),
            Covered("potions owned", ModelDb.AllPotions, PotionTypes),
            Covered("powers seen", ModelDb.AllPowers, SeenPowerTypes),
            Covered("characters played", ModelDb.AllCharacters, CharacterTypes),
            Covered("monsters met", ModelDb.Monsters, MonsterTypes),
            CoveredTypes("encounters entered", KnownEncounters, EncounterTypes),
            CoveredTypes("events entered", KnownEvents, EventTypes),
            Covered("acts entered", ModelDb.Acts, ActTypes)));

        int passed = outcomes.Count(o => o.Result == "PASS");
        int skipped = outcomes.Count(o => o.Result == "SKIP");
        var mode = SelfTestNet.Multiplayer ? $" mode=multiplayer-{SelfTestNet.Role}" : "";
        Log($"selftest summary: passed={passed}/{outcomes.Count - skipped} skipped={skipped} scope={scope}{mode} " +
            $"elapsed={Seconds:F1}s " + string.Join(" ", outcomes.Select(o => $"{o.Name}={o.Result}({o.Seconds:F1}s)")));

        if (setupFailure != null)
        {
            Log($"selftest FAILED: {setupFailure}");
            return;
        }
        // A skipped scenario is neither a pass nor a failure: it was not run in this mode.
        var bad = outcomes.Where(o => o.Result is not ("PASS" or "SKIP")).ToList();
        if (bad.Count == 0)
        {
            Log($"state proof: kit summary passed={passed}/{outcomes.Count - skipped} skipped={skipped} scope={scope}{mode}");
            Log("selftest done");
            return;
        }
        var kind = bad.All(o => o.Result == "TIMEOUT") ? "timeout" : "state proof";
        Log($"selftest FAILED: {kind}: {bad.Count} of {outcomes.Count} scenarios did not pass: " +
            string.Join("; ", bad.Select(o => $"{o.Name} {o.Result} {o.Detail}")));
    }
}

/// <summary>
/// Multiplayer Tier 2 plumbing. Both peers run the same scenario code. Every state change is a
/// numbered step: the acting peer(s) request it through a RitsuLib managed net action, and every
/// peer executes it in queue order with its own registration of the same code line, so the two
/// simulations stay equal. Singleplayer runs each step at once.
/// </summary>
internal static class SelfTestNet
{
    private static readonly TimeSpan StepTimeout = TimeSpan.FromSeconds(45);
    private static string _scenario = "";
    private static readonly Dictionary<string, int> Counters = new();
    private static readonly Dictionary<string, (string Label, Func<Player, Task<object?>> Body)> Steps = new();
    private static readonly Dictionary<(ulong Owner, string Key), (object? Value, Exception? Error)> Done = new();

    private static readonly RitsuLibManagedNetActionDescriptor<StepMessage> Descriptor = new(
        MainFile.ModId, "selftest-step", Encode, Decode, Execute, GameActionType.Any);

    private readonly record struct StepMessage(string Key, string Label);

    internal static string? Role { get; private set; }
    internal static bool Multiplayer => Role != null;
    internal static bool IsHost => Role == "host";
    internal static ulong HostNetId { get; set; }
    /// <summary>True while the queue holds a step this peer's scenario code has not reached yet.</summary>
    internal static bool AwaitingRegistration { get; private set; }
    /// <summary>Step keys restart per scenario phase, so one peer's failure cannot shift the next phase.</summary>
    internal static string Phase { get; set; } = "setup";

    internal static void Arm(string? role)
    {
        Role = role is "host" or "client" ? role : null;
        if (Multiplayer)
            RitsuLibManagedNetActions.Register(Descriptor);
    }

    internal static void BeginScenario(string name)
    {
        _scenario = name;
        Phase = "setup";
        Counters.Clear();
    }

    internal static Player LocalPlayer()
        => LocalContext.GetMe(RunManager.Instance.DebugOnlyGetState())
           ?? throw new InvalidOperationException("no local player");

    /// <summary>
    /// Run <paramref name="body"/> on every peer. Only the host requests it, unless
    /// <paramref name="everyPeer"/> is set: then each peer requests it for its own player and the
    /// call returns after every player's copy ran. Returns this peer's result for the step it waited on.
    /// </summary>
    internal static async Task<T> Step<T>(string label, Player owner, Func<Player, Task<T>> body,
        bool everyPeer, CancellationToken ct)
    {
        if (!Multiplayer)
            return await body(owner);
        Counters.TryGetValue(Phase, out var n);
        Counters[Phase] = ++n;
        var key = $"{_scenario}/{Phase}/{n}";
        Steps[key] = (label, async player => await body(player));
        var me = LocalPlayer();
        if (everyPeer || IsHost)
            await RequestUntilSent(new StepMessage(key, label), ct);
        var owners = everyPeer
            ? RunManager.Instance.DebugOnlyGetState()!.Players.Select(p => p.NetId).ToList()
            : new List<ulong> { HostNetId };
        var deadline = DateTime.UtcNow + StepTimeout;
        while (!owners.All(id => Done.ContainsKey((id, key))))
        {
            ct.ThrowIfCancellationRequested();
            if (DateTime.UtcNow > deadline)
                throw new TimeoutException($"multiplayer step '{label}' ({key}) did not run on this peer within {StepTimeout.TotalSeconds:F0}s");
            await SelfTestKit.NextFrame();
        }
        if (owners.Select(id => Done[(id, key)].Error).FirstOrDefault(e => e != null) is { } error)
            throw new InvalidOperationException($"multiplayer step '{label}' failed: {error.Message}", error);
        return (T)Done[(everyPeer ? me.NetId : HostNetId, key)].Value!;
    }

    private static async Task RequestUntilSent(StepMessage message, CancellationToken ct)
    {
        var deadline = DateTime.UtcNow + TimeSpan.FromSeconds(30);
        while (!RitsuLibManagedNetActions.Request(RunManager.Instance, Descriptor, message))
        {
            ct.ThrowIfCancellationRequested();
            if (DateTime.UtcNow > deadline)
                throw new TimeoutException($"multiplayer step '{message.Label}' could not be sent for 30s; " +
                    "does the other peer run the same RitsuLib?");
            await SelfTestKit.NextFrame();
        }
    }

    private static async Task Execute(RitsuLibManagedNetActionContext<StepMessage> context)
    {
        var (key, label) = (context.Message.Key, context.Message.Label);
        var owner = context.Player;
        // A slower peer may not have reached this code line yet; the queue waits for it.
        var deadline = DateTime.UtcNow + StepTimeout;
        AwaitingRegistration = !Steps.ContainsKey(key);
        while (!Steps.ContainsKey(key))
        {
            if (DateTime.UtcNow > deadline)
            {
                AwaitingRegistration = false;
                SelfTestKit.Log($"multiplayer step '{label}' ({key}) from {owner.NetId} never registered on this peer: " +
                                "the peers' scenario code took different paths");
                Done[(owner.NetId, key)] = (null, new InvalidOperationException($"step {key} was not registered on this peer"));
                return;
            }
            await SelfTestKit.NextFrame();
        }
        AwaitingRegistration = false;
        var step = Steps[key];
        if (step.Label != label)
        {
            SelfTestKit.Log($"multiplayer step {key} is '{label}' on {owner.NetId} but '{step.Label}' here: " +
                            "the peers' scenario code took different paths");
            Done[(owner.NetId, key)] = (null, new InvalidOperationException($"step {key} label mismatch"));
            return;
        }
        try
        {
            Done[(owner.NetId, key)] = (await step.Body(owner), null);
            SelfTestKit.Log($"multiplayer step ran: {key} '{label}' for {owner.NetId}");
        }
        catch (Exception e)
        {
            SelfTestKit.Log($"multiplayer step '{label}' ({key}) for {owner.NetId} threw {e.GetType().Name}: {e.Message}");
            Done[(owner.NetId, key)] = (null, e);
        }
    }

    private static byte[] Encode(StepMessage message) => Encoding.UTF8.GetBytes(message.Key + "\n" + message.Label);

    private static StepMessage Decode(ReadOnlySpan<byte> bytes)
    {
        var text = Encoding.UTF8.GetString(bytes);
        var split = text.IndexOf('\n');
        return new StepMessage(text[..split], text[(split + 1)..]);
    }

    /// <summary>One line of run and combat state; equal on every peer when the simulations agree.</summary>
    internal static string Digest()
    {
        var run = RunManager.Instance.DebugOnlyGetState();
        if (run == null)
            return "no run";
        var text = new StringBuilder();
        foreach (var player in run.Players.OrderBy(p => p.NetId))
        {
            var creature = player.Creature;
            text.Append($"P{player.NetId}:hp={creature.CurrentHp}/{creature.MaxHp},blk={creature.Block},gold={player.Gold}," +
                        $"deck={player.Deck.Cards.Count},relics=[{string.Join(",", player.Relics.Select(r => r.Id.Entry))}]," +
                        $"potions=[{string.Join(",", player.PotionSlots.Where(p => p != null).Select(p => p!.Id.Entry))}]");
            if (player.PlayerCombatState is { } combat)
                text.Append($",en={combat.Energy},hand=[{string.Join(",", combat.Hand.Cards.Select(c => c.Id.Entry))}]," +
                            $"pow=[{Powers(creature)}]");
            text.Append(';');
        }
        if (CombatManager.Instance.DebugOnlyGetState() is { } state)
        {
            var index = 0;
            foreach (var enemy in state.Enemies)
                text.Append($"E{index++}:{enemy.Monster?.Id.Entry},hp={enemy.CurrentHp}/{enemy.MaxHp}," +
                            $"blk={enemy.Block},pow=[{Powers(enemy)}];");
        }
        return text.ToString();
    }

    private static string Powers(Creature creature)
        => string.Join(",", creature.Powers.Select(p => $"{p.Id.Entry}:{p.Amount}").OrderBy(s => s, StringComparer.Ordinal));
}
